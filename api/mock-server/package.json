{
  "name": "@local/mock-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./browser": "./src/browser.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "codegen": "tsx scripts/codegen-admin-openapi.ts && openapi-ts && tsx scripts/codegen-mock-runtime.ts",
    "codegen:contract": "tsx scripts/codegen-admin-openapi.ts && openapi-ts",
    "codegen:mock-runtime": "tsx scripts/codegen-mock-runtime.ts",
    "dev": "tsx src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@msw/data": "1.1.6",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.1",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "^2.8.1"
  }
}
